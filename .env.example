# Background Worker & Cron Processing Secret
# Token required in Bearer authorization header when calling /api/jobs/process
CRON_SECRET=dqS61PbjyCs6LkO4goKAQGY/K8evwF2wYggL18hr3zE=

# Database Connection (PostgreSQL with GiST exclusion constraints)
DATABASE_URL=postgresql://neondb_owner:npg_nap2JfimcU3o@ep-morning-boat-azfg8w2m.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Scheduling & Clinic Configuration
