# ==============================================================================
# CareFlow Environment Configuration
# Copy this template to `.env` and configure with your local or production values.
# NEVER commit your real `.env` file to version control.
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authentication & Encryption Secrets
# Minimum 32-character random string used for session signing and AES-256-GCM token encryption
SESSION_SECRET=careflow-development-session-secret-must-be-32-chars!

# Background Worker & Cron Processing Secret
# Token required in Bearer authorization header when calling /api/jobs/process
CRON_SECRET=careflow-cron-worker-secret-key

# Database Connection (PostgreSQL with GiST exclusion constraints)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careflow_dev?schema=public

# Scheduling & Clinic Configuration
CLINIC_TIMEZONE=Asia/Kolkata
SLOT_HOLD_MINUTES=5

# OpenAI API Configuration (LLM Pre-Visit Urgency Triage & Post-Visit Summaries)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Google OAuth 2.0 (Google Calendar Integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/callback

# Email Notification Delivery (SMTP / Transactional Service)
# In development, leave blank to use mock console logger
EMAIL_SMTP_URL=smtp://user:pass@smtp.mailtrap.io:2525
EMAIL_FROM="CareFlow Health <noreply@careflow.com>"
