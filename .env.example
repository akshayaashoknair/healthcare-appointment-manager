# Copy this file to `.env` and fill in real secrets. Keep `.env` out of git.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Scheduling and clinic availability
CLINIC_TIMEZONE=Asia/Kolkata
SLOT_HOLD_MINUTES=5

# OpenAI (LLM)
OPENAI_API_KEY=

# Google OAuth (Calendar integration)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email provider (SMTP or transactional provider URL)
EMAIL_SMTP_URL=

